{
  "name": "dulce-chrome-extension",
  "version": "1.0.0",
  "private": true,
  "description": "Dulce for Chrome: the glucose value from the Dulce app on the browser toolbar.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:staging": "node scripts/build.mjs --relay staging",
    "build:local": "node scripts/build.mjs --relay local",
    "zip": "node scripts/build.mjs --zip",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.8",
    "esbuild": "^0.28.2",
    "puppeteer-core": "^25.19.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  }
}
